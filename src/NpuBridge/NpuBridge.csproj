<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NpuBridge: the ARM64 executable. Hosts Kestrel, parses the command line, runs as a Windows service,
    and contains the two real adapters (PhiSilicaBackend, AionBackend) plus packaging glue.
    Keep logic out of here; if it needs a test, it belongs in NpuBridge.Core.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RootNamespace>NpuBridge</RootNamespace>
    <AssemblyName>NpuBridge</AssemblyName>

    <!-- Both on-device model frameworks are ARM64-only (docs/FUTURE.md covers x64). -->
    <Platforms>ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- One output folder whether built via the solution or the project: bin\<Config>\<tfm>\win-arm64. The sparse package is registered against it. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!-- LibraryImport source generation (ProcessIdentity.cs) and CsWinRT projections need this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Do NOT let the Windows App SDK auto-initialize its bootstrapper at process start. Only the
      Phi Silica adapter needs it, and `- -backend fake` must start on a machine without the runtime.
      (docs/DECISIONS.md D13). Takes effect once Microsoft.WindowsAppSDK is referenced in chunk 2.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!--
      CsWinRT's projection step looks for a registry-installed Windows SDK by default. Use the
      NuGet-delivered Windows metadata instead so the build needs only the .NET SDK (as the Aion sample does).
    -->
    <WindowsAppSdkVersion>2.4.1-experimental</WindowsAppSdkVersion>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\$(WindowsSdkPackageVersion)\winmd</CsWinRTWindowsMetadata>

    <!--
      Aion Instruct Preview: the SDK NuGet is not on nuget.org. It comes from the sample repo's GitHub
      release into nuget-local/ (gitignored, wired by nuget.config). When the file is absent (CI, or a
      fresh clone that has not fetched it) the adapter is left out of the build and the aion backend
      reports why in /healthz, so one solution builds everywhere and the Core tests still run (D66).
    -->
    <AionSdkVersion>1.0.0</AionSdkVersion>
    <AionSdkNupkg>$(MSBuildThisFileDirectory)..\..\nuget-local\AionInstructPreview.Text.Framework.$(AionSdkVersion).nupkg</AionSdkNupkg>
    <AionSdkAvailable Condition="Exists('$(AionSdkNupkg)')">true</AionSdkAvailable>
    <DefineConstants Condition="'$(AionSdkAvailable)' == 'true'">$(DefineConstants);AION_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(AionSdkAvailable)' == 'true'">
    <!-- Its props feed CsWinRT the AionInstructPreview.Text winmd and add the namespace to CsWinRTIncludes. -->
    <PackageReference Include="AionInstructPreview.Text.Framework" Version="$(AionSdkVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(AionSdkAvailable)' != 'true'">
    <Compile Remove="Backends\AionBackend.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NpuBridge.Core\NpuBridge.Core.csproj" />
    <!-- Console SDK on purpose (service tooling, no wwwroot); Kestrel comes from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <!--
      Phi Silica: Microsoft.Windows.AI.Text ships in the Windows App SDK (stable 2.x). CsWinRT must be a
      DIRECT reference or its projection targets never run (see the Aion sample README).
    -->
    <!--
      One place for the Windows App SDK version. packaging/AppxManifest.xml must name the matching runtime
      framework family (experimental channels use a different family than stable); see DECISIONS D31.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Direct reference only to get $(PkgMicrosoft_WindowsAppSDK_Runtime) for the version-constants source below. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSdkVersion)" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Release/Runtime version constants used by the explicit Bootstrap call in PhiSilicaBackend. If
      WindowsAppSdkBootstrapInitialize is ever turned on, the SDK targets add their own copy of this file
      and this Compile item must go (CS0101 duplicate type otherwise).
    -->
    <Compile Include="$(PkgMicrosoft_WindowsAppSDK_Runtime)\include\WindowsAppSDK-VersionInfo.cs" Link="Generated\WindowsAppSDK-VersionInfo.cs" />
  </ItemGroup>

</Project>
