<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NpuBridge.Core: everything with logic, and nothing that touches WinRT.
    OpenAI DTOs and endpoint mapping, prompt flattening, context cache, scheduler, SSE, tool emulation,
    the backend interface and the fake backend. Runs anywhere .NET runs, so the test suite never
    needs the NPU. See docs/PLAN.md §2 and docs/DECISIONS.md D1.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NpuBridge</RootNamespace>
    <AssemblyName>NpuBridge.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Endpoint mapping lives here so TestServer-based tests cover the real HTTP surface. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Phi-3 token counts for usage and the max_tokens budget on Phi Silica (D80). Managed only. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phi-3.5-mini's SentencePiece model, MIT; see Tokenizers/Phi3/README.md for provenance. -->
    <EmbeddedResource Include="Tokenizers\Phi3\tokenizer.model" LogicalName="NpuBridge.Tokenizers.Phi3.tokenizer.model" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NpuBridge.Tests" />
  </ItemGroup>

</Project>
