<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources:
    1. nuget.org — Windows App SDK, CsWinRT, ASP.NET Core test host, xunit.
    2. ./nuget-local — the Aion Instruct Preview SDK NuGet (AionInstructPreview.Text.Framework.<ver>.nupkg),
       which is not on nuget.org. Download it from
       https://github.com/microsoft/Aion-Instruct-Preview-Sample/releases into nuget-local/ (gitignored).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="aion-instruct-preview-local" value="./nuget-local" />
  </packageSources>
</configuration>
