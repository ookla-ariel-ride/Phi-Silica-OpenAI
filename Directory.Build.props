<Project>
  <!-- Shared settings for every project in the solution. Per-project files add only what differs. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      CA1848/CA1873: LoggerMessage source generators for every log call. Not worth it at this request rate.
      CA2007: ConfigureAwait(false) is applied in library code by hand where it matters; ASP.NET Core handlers don't need it.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007</NoWarn>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>npu-bridge</Company>
    <Product>npu-bridge</Product>
    <Version>0.1.0</Version>
    <!-- Keep the 40-char commit hash out of the version string shown by the version verb and /healthz. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
